with "config/tempus_config.gpr";
with "sml";

--  Tempus: SPARK-provable RFC3339 timestamps and civil-calendar arithmetic.
--  A pure library (zero IO): every unit carries SPARK_Mode and may depend
--  only on other Tempus units and the sml state-machine library -- never on
--  Ada.Calendar, files, or sockets.  Consumers build it through their Alire
--  profile; the example and test crates select -O3/-O0 with the MODE
--  external (the sml-ada convention).  proof/proof.gpr sources src/ directly
--  and withs only sml, keeping foreign code out of the proof tree.
project Tempus is

   for Library_Name use "Tempus";
   for Library_Version use
     Project'Library_Name & ".so." & Tempus_Config.Crate_Version;

   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Tempus_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Library_Dir use "lib";

   type Library_Type_Type is ("relocatable", "static", "static-pic");
   Library_Type : Library_Type_Type :=
     external ("TEMPUS_LIBRARY_TYPE", external ("LIBRARY_TYPE", "static"));
   for Library_Kind use Library_Type;

   package Compiler is
      for Default_Switches ("Ada") use Tempus_Config.Ada_Compiler_Switches;
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Tempus;
