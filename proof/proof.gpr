with "sml";

--  SPARK proof target.  Not built by `alr build`; analysed with
--  `alr exec -- gnatprove -P proof/proof.gpr`.
--
--  Sources the library directly (rather than withing tempus.gpr) because the
--  Alire-generated config gpr withs every dependency's project, which would
--  drag foreign code into the proof tree.  This tree is exactly the proof
--  harnesses + src + sml, mirroring sml-ada's proof setup.  gnatprove
--  analyses generics only through concrete instances, so the harness sources
--  here provide them (core_closure_proof.ads withs every unit).
project Proof is

   for Source_Dirs use ("src", "../src");
   for Object_Dir use "obj";

   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata");
   end Compiler;

end Proof;
